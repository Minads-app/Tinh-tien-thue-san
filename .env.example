# ============================================================
# FILE NÀY LÀ TEMPLATE – KHÔNG CHỨA GIÁ TRỊ THẬT
# Khi triển khai lên VPS, copy file này thành .env
# rồi điền đầy đủ các giá trị thật vào
# ============================================================

# PORT mà Express server sẽ lắng nghe (PM2 sẽ dùng port này)
PORT=3001

# API Key của bạn trên SePay Dashboard (để xác thực webhook)
SEPAY_API_KEY=your_sepay_api_key_here

# Service Account JSON của Firebase (tải từ Firebase Console > Project Settings > Service Accounts)
# Lưu ý: Giữ nguyên dấu nháy đơn bọc ngoài chuỗi JSON
FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "your-project-id", ...}'
